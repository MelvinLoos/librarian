# Environment variables for the Librarian Backend

# The base path for your Calibre library (where metadata.db and the book files live).
# This is the single source of truth: the SQLite database is always read from
# <CALIBRE_LIBRARY_PATH>/metadata.db.
# Use an absolute path, or a path relative to the /backend directory.
CALIBRE_LIBRARY_PATH="../library"

# OPTIONAL database override. Only set this if you want to point Prisma at a
# database that is NOT the Calibre library's metadata.db (e.g. a test database,
# or a non-Calibre deployment). Accepts a `file:` URI, a plain filesystem path,
# or the literal `:memory:`.
# DATABASE_URL="file:./test.db"

# JWT Secrets for Authentication. Change these to long random strings in production!
JWT_SECRET="develop-secret-key-replace-in-production"
JWT_REFRESH_SECRET="develop-refresh-secret-replace-in-production"

# Environment
NODE_ENV="development"
PORT=3001